EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
POSTHOG_PROJECT_TOKEN=your_posthog_project_token
POSTHOG_HOST=https://your-posthog-host
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

# Vision Agent service (Python) — used by the agent-session API route
# Default: http://localhost:8000 (run `uv run main.py serve` inside vision-agent/)
VISION_AGENT_URL=http://localhost:8000

# OpenAI API key — used server-side by the Chat tab's /api/chat route.
# The vision-agent Python service also needs it (in vision-agent/.env or here).
OPENAI_API_KEY=your_openai_api_key
# Optional: override the model used by /api/chat (default: gpt-4o-mini)
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Hosted API (Vercel) used by release/APK builds, e.g. https://lingua.vercel.app
# Leave unset for local development.
# EXPO_PUBLIC_API_ORIGIN=
